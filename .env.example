# Web3Forms access key — get a free one at https://web3forms.com (enter your
# email, they mail you the key instantly). Submissions land in that inbox.
NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Public site URL, used for canonical/OG metadata.
NEXT_PUBLIC_SITE_URL=https://vaultra.in

# ── Deal alert bot (lib/bots) ────────────────────────────────────────────────
# Every bot setting is BOT_-prefixed. Leave a channel's vars empty and that
# channel simply reports itself as not ready; the site is unaffected either way.

# Telegram — free, no approval. @BotFather gives you the token.
BOT_TELEGRAM_TOKEN=
# Any random string. Pass the same one to setWebhook as secret_token.
BOT_TELEGRAM_SECRET=

# WhatsApp Cloud API — developers.facebook.com → your app → WhatsApp.
BOT_WHATSAPP_TOKEN=
BOT_WHATSAPP_PHONE_ID=
# Your own random string; Meta echoes it back during the webhook handshake.
BOT_WHATSAPP_VERIFY_TOKEN=
# App secret, used to check the signature on every delivery.
BOT_WHATSAPP_APP_SECRET=
# Approved template for alerts sent outside the free 24h window. Leave empty
# and the bot only messages people whose window is still open (free).
BOT_WHATSAPP_TEMPLATE=
BOT_WHATSAPP_TEMPLATE_LANG=en

# Upstash Redis (Vercel Marketplace → Upstash). Without these the bot falls
# back to a temp-file store that works locally and nowhere else.
# Vercel's Upstash integration already sets KV_REST_API_URL / KV_REST_API_TOKEN;
# the bot reads those automatically. Only set these two to override them.
BOT_UPSTASH_URL=
BOT_UPSTASH_TOKEN=

# Guards /api/bots/cron/deals. Generate with: openssl rand -hex 24
BOT_CRON_SECRET=

# Channel-native ids allowed to post deals: Telegram chat ids, WhatsApp numbers.
BOT_ADMIN_IDS=

# Amazon Associates tag added to every amazon.in link.
BOT_AMAZON_TAG=750655-21
